# Copie para .env e ajuste. Sem DATABASE_URL o servidor usa o PGlite (PostgreSQL embutido) em data/pglite.
# Formato igual ao do Prisma: o ?schema= define o schema usado (search_path).
DATABASE_URL="postgresql://USUARIO:SENHA@10.102.55.11:5432/postgres?schema=SEU_RA"
PORT=8000
# SEED=false  # não insere os dados de exemplo em um banco vazio

# Opcional: roda os testes e2e num PostgreSQL real. O schema (terminado em _teste) é APAGADO a cada teste.
# TEST_DATABASE_URL="postgresql://USUARIO:SENHA@10.102.55.11:5432/postgres?schema=SEU_RA_teste"
